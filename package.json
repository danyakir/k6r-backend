        "@kubernetes/client-node": "^0.20.0",
        "@prisma/client": "^6.14.0",
        "dotenv": "^16.5.0",
        "fastify": "^5.2.1",
        "fastify-type-provider-zod": "^4.0.2",
        "http-context-nodejs": "^1.0.1",
        "http-status-codes": "^2.3.0",
        "openid-client": "^5.7.1",
        "openshift-rest-client": "^9.1.0",
        "prisma": "^6.14.0",
