{
    "name": "k6-cloud-runner",
    "version": "1.0.0",
    "description": "Web application for running k6 tests on openshift",
    "main": "src/main.ts",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "build": "rm -rf dist && npm run prisma:generate && tsc && tsc-alias",
        "prisma:generate": "prisma generate",
        "dev": "nodemon src/main.ts",
        "lint": "eslint --ext .ts .",
        "start": "node ./dist/main.js"
    },
